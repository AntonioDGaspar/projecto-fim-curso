generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Classe {
  idClasse Int     @id @default(autoincrement())
  nome     String
  Turma    Turma[]
}

model Curso {
  idCurso Int     @id @default(autoincrement())
  nome    String
  Turma   Turma[]
}

model DiaSemana {
  idDiaSemana     Int               @id @default(autoincrement())
  nome            String            @unique
  Disponibilidade Disponibilidade[]
  TempoLectivo    TempoLectivo[]
}

model Disciplina {
  idDisciplina    Int               @id @default(autoincrement())
  nome            String
  ProfDisciplinas ProfDisciplinas[]
  TempoLectivo    TempoLectivo[]
}

model Disponibilidade {
  idDisponibilidade Int            @id @default(autoincrement())
  diaSemanaId       Int
  periodoId         String
  ordem             Int
  professorId       Int
  DiaSemana         DiaSemana      @relation(fields: [diaSemanaId], references: [idDiaSemana])
  Periodo           Periodo        @relation(fields: [periodoId], references: [periodo])
  KENA_Professor    KENA_Professor @relation(fields: [professorId], references: [id_professor])
}

model KENA_Admin {
  id_admin        Int             @id @default(autoincrement())
  id_Usuario      Int             @unique
  created_at      DateTime        @default(now())
  updated_at      DateTime
  KENA_Utilizador KENA_Utilizador @relation(fields: [id_Usuario], references: [id], onDelete: Cascade)
}

model KENA_Aluno {
  id_aluno        Int             @id @default(autoincrement())
  id_Usuario      Int             @unique
  num_matricula   String
  created_at      DateTime        @default(now())
  updated_at      DateTime
  KENA_Utilizador KENA_Utilizador @relation(fields: [id_Usuario], references: [id])
}

model KENA_Professor {
  id_professor         Int               @id @default(autoincrement())
  id_Usuario           Int               @unique
  disciplina_principal String
  created_at           DateTime          @default(now())
  updated_at           DateTime
  Disponibilidade      Disponibilidade[]
  KENA_Utilizador      KENA_Utilizador   @relation(fields: [id_Usuario], references: [id])
  ProfDisciplinas      ProfDisciplinas[]
  ProfTurma            ProfTurma[]
  TempoLectivo         TempoLectivo[]
}

model KENA_Utilizador {
  id             Int             @id @default(autoincrement())
  workos_id      String?         @unique
  nome           String
  email          String?         @unique
  tipo           UserType
  created_at     DateTime        @default(now())
  updated_at     DateTime
  KENA_Admin     KENA_Admin?
  KENA_Aluno     KENA_Aluno?
  KENA_Professor KENA_Professor?
}

model Periodo {
  periodo         String            @id
  Disponibilidade Disponibilidade[]
  TempoLectivo    TempoLectivo[]
}

model ProfDisciplinas {
  idProfDisciplina Int            @id @default(autoincrement())
  professorId      Int
  disciplinaId     Int
  Disciplina       Disciplina     @relation(fields: [disciplinaId], references: [idDisciplina])
  KENA_Professor   KENA_Professor @relation(fields: [professorId], references: [id_professor])

  @@unique([professorId, disciplinaId])
}

model ProfTurma {
  idProfTurma    Int            @id @default(autoincrement())
  professorId    Int
  turmaId        Int
  KENA_Professor KENA_Professor @relation(fields: [professorId], references: [id_professor])
  Turma          Turma          @relation(fields: [turmaId], references: [idTurma])

  @@unique([professorId, turmaId])
}

model Sala {
  idSala       Int            @id @default(autoincrement())
  nome         String
  TempoLectivo TempoLectivo[]
}

model TempoLectivo {
  idTempoLectivo Int            @id @default(autoincrement())
  diaSemanaId    Int
  periodoId      String
  ordem          Int
  professorId    Int
  disciplinaId   Int
  salaId         Int
  turmaId        Int
  DiaSemana      DiaSemana      @relation(fields: [diaSemanaId], references: [idDiaSemana])
  Disciplina     Disciplina     @relation(fields: [disciplinaId], references: [idDisciplina])
  Periodo        Periodo        @relation(fields: [periodoId], references: [periodo])
  KENA_Professor KENA_Professor @relation(fields: [professorId], references: [id_professor])
  Sala           Sala           @relation(fields: [salaId], references: [idSala])
  Turma          Turma          @relation(fields: [turmaId], references: [idTurma]) 
}

model Turma {
  idTurma      Int            @id @default(autoincrement())
  nome         String
  classeId     Int
  cursoId      Int
  ProfTurma    ProfTurma[]
  TempoLectivo TempoLectivo[]
  Classe       Classe         @relation(fields: [classeId], references: [idClasse])
  Curso        Curso          @relation(fields: [cursoId], references: [idCurso])
}

enum UserType {
  Admin
  Professor
  Aluno
}
